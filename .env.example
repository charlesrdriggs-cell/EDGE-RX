# Required: long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# The operator (you) account, created automatically on first start
OPERATOR_EMAIL=you@example.com
OPERATOR_PASSWORD=change-me

# Public URL of the site (used in email links and payment redirects)
APP_URL=http://localhost:3000
BUSINESS_NAME=Edge RX

# Email (optional). Without a key, emails are saved to the in-app outbox instead of sent.
# Sign up at https://resend.com, verify your domain, and paste the API key here.
RESEND_API_KEY=
EMAIL_FROM="Edge RX <tunes@yourdomain.com>"

# Payments (optional). Without a key, customers pay at pickup and you mark orders paid.
# Sign up at https://stripe.com and paste your secret key (sk_test_... to try it out).
STRIPE_SECRET_KEY=

# Protects the weekly reminder endpoint (/api/cron/reminders?key=...)
CRON_SECRET=change-me-too

# Where the SQLite database lives (defaults to ./data/app.db)
# DATABASE_PATH=/var/data/app.db

# Your local time zone (used for "today", pickup dates and the dashboard)
BUSINESS_TIMEZONE=America/New_York
